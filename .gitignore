# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environment ───────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── App runtime data ──────────────────────────────────────────────
# User chat history, RAG documents, uploaded files, audit logs
config/
workspace/
logs/
*.log

# ── Secrets & credentials ─────────────────────────────────────────
config/users.json
*.env
.env
.env.*
secrets.toml
.streamlit/secrets.toml

# ── AI stack runtime files (generated by ai_stack_manager.sh) ────
# Model files are large binaries — track catalogue, not the files
*.gguf
*.bin
*.safetensors
*.ggml

# Stack process state
.pids
.active_model

# ── Streamlit ─────────────────────────────────────────────────────
.streamlit/

# ── Intel oneAPI / build artifacts ───────────────────────────────
build/
*.o
*.a

# ── OS / editor ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Test artefacts ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Docker ────────────────────────────────────────────────────────
# SearXNG config is generated by setup — don't commit instance config
searxng-config/

# ── Keep these even though parent dirs are ignored ───────────────
!config/.gitkeep
!workspace/.gitkeep
!logs/.gitkeep
