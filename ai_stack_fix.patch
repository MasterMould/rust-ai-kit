--- install_ai_stack.sh	2026-01-01
+++ install_ai_stack.sh	2026-01-01
@@
STEP "2/7  Intel Arc A770 GPU drivers"

sudo apt install -y 
intel-opencl-icd 
intel-level-zero-gpu 
level-zero 
clinfo 
libze1 
libze-dev

OK "Intel compute-runtime packages ready"

+echo "Installing Intel math libraries"
+
+sudo apt install -y 
+intel-oneapi-mkl 
+intel-oneapi-mkl-devel 
+intel-oneapi-dnnl 
+intel-oneapi-dnnl-devel
+
+OK "Intel MKL + oneDNN installed"
+

@@
STEP "Loading Intel oneAPI environment"

-source /opt/intel/oneapi/setvars.sh --force
+OLD_OPTS=$(set +o)
+
+set +e
+set +u
+
+export OCL_ICD_FILENAMES=${OCL_ICD_FILENAMES:-}
+
+source /opt/intel/oneapi/setvars.sh --force
+
+eval "$OLD_OPTS"

OK "Intel environment loaded"

@@
+STEP "Toolchain validation"
+
+TOOLS=(icx icpx cmake ninja git cargo clinfo)
+
+for tool in "${TOOLS[@]}"; do

* if command -v "$tool" >/dev/null 2>&1; then
* ```
     OK "$tool detected"
  ```
* else
* ```
     ERR "$tool missing"
  ```
* fi
  +done
*

+echo
+echo "Testing OpenCL runtime"
+
+clinfo | grep -qi arc \

* && OK "Intel Arc visible via OpenCL" \
* || ERR "Arc GPU not detected"
*

+echo
+echo "Testing SYCL GPU execution"
+
+cat <<EOF >/tmp/sycl_test.cpp
+#include <sycl/sycl.hpp>
+#include <iostream>
+int main(){

* sycl::queue q(sycl::gpu_selector_v);
* std::cout << q.get_device().get_info[sycl::info::device::name](sycl::info::device::name)() << std::endl;
  +}
  +EOF
*

+icpx -fsycl /tmp/sycl_test.cpp -o /tmp/sycl_test
+
+/tmp/sycl_test | grep -qi arc \

* && OK "SYCL running on Arc GPU" \
* || ERR "SYCL GPU execution failed"
*

+echo
+echo "Testing MKL runtime"
+
+cat <<EOF >/tmp/mkl_test.c
+#include <stdio.h>
+#include <mkl.h>
+int main(){ printf("MKL OK\n"); }
+EOF
+
+icx /tmp/mkl_test.c -lmkl_rt -lpthread -ldl -o /tmp/mkl_test
+
+/tmp/mkl_test >/dev/null \

* && OK "MKL operational" \
* || ERR "MKL runtime failed"
*

+echo
+echo "Testing BLAS"
+
+ldconfig -p | grep -q openblas \

* && OK "OpenBLAS present" \
* || ERR "OpenBLAS missing"
*

+OK "Validation complete"
+
STEP "4/7  Building llama.cpp (Intel Arc SYCL)"

